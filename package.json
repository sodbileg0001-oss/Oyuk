{
  "name": "a-little-letter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "content": "node scripts/sync-content.mjs",
    "predev": "npm run content",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run content",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check:content": "node scripts/check-content.mjs",
    "test": "playwright test",
    "test:api": "tsx --test tests-api/*.test.ts",
    "check:secrets": "node scripts/check-client-secrets.mjs",
    "check:fonts": "node scripts/check-fonts.mjs",
    "preview:mobile": "node scripts/capture-mobile.mjs"
  },
  "dependencies": {
    "@fontsource/noto-serif": "^5.2.0",
    "@fontsource/noto-sans": "^5.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.3",
    "tsx": "^4.20.0",
    "vite": "^7.1.0"
  },
  "engines": { "node": "24.x" }
}
